# Database
DATABASE_URL=postgresql://user:password@host/db

# ── Sentry error tracking ──────────────────────────────────────────────────
# Backend DSN — used by api-server (initialized in src/lib/sentry.ts).
SENTRY_DSN_BACKEND=

# Frontend DSN — exposed to the browser. Must be prefixed with VITE_ so
# Vite inlines it into the lp-studio bundle (see src/main.tsx).
VITE_SENTRY_DSN_FRONTEND=

# Release identifier — typically the git SHA or a deploy version. Used by
# both backend Sentry init and the Vite source map upload step so stack
# traces are tied to the exact build that produced them.
SENTRY_RELEASE=
VITE_SENTRY_RELEASE=

# Source map upload (build-time only — never read at runtime).
# Required for the Sentry Vite plugin to upload source maps so production
# stack traces become readable. If unset, the upload step silently no-ops.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
