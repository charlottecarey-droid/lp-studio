# Example environment file for the workspace.
# Copy to `.env` and fill in real values, or set via the Replit Secrets UI.

# ── Required ────────────────────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql://user:password@host/db

# CSRF protection (task #149). The api-server fails to boot if this is
# missing in production. Generate a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CSRF_SECRET=

# ── Sentry error tracking ──────────────────────────────────────────────────
# Backend DSN — used by api-server (initialized in src/lib/sentry.ts).
SENTRY_DSN_BACKEND=

# Frontend DSN — exposed to the browser. Must be prefixed with VITE_ so
# Vite inlines it into the lp-studio bundle (see src/main.tsx).
VITE_SENTRY_DSN_FRONTEND=

# Release identifier — typically the git SHA or a deploy version. Used by
# both backend Sentry init and the Vite source map upload step so stack
# traces are tied to the exact build that produced them.
SENTRY_RELEASE=
VITE_SENTRY_RELEASE=

# Source map upload (build-time only — never read at runtime).
# Required for the Sentry Vite plugin to upload source maps so production
# stack traces become readable. If unset, the upload step silently no-ops.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Optional ────────────────────────────────────────────────────────────────

# Google OAuth — sign-in flow. Leave unset to disable Google login.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# Fallback admin password login. Leave unset to disable.
# ADMIN_PASSWORD=

# ── Load / cost protections (June 2026 launch hardening) ───────────────────
# All of these are per-process, in-memory limits (single-instance Replit
# deployment) — see api-server/src/lib/rateLimit.ts and semaphore.ts.
# Defaults shown; leave unset unless you need to retune under live load.

# Public-endpoint rate limits (requests per minute, fixed window, per client IP).
# RATE_LIMIT_TRACKING_PER_MIN=500       # POST /api/lp/track — visitor analytics events
# RATE_LIMIT_HEATMAP_PER_MIN=100        # POST /api/lp/heatmap — heatmap batch ingest (≤200 events/POST)
# RATE_LIMIT_LEADS_PER_MIN=10           # POST /api/lp/leads — form/lead submissions (multi-step forms submit once)
# RATE_LIMIT_IMAGE_GENERATE_PER_MIN=10  # POST /api/lp/image/generate — keyed per TENANT, not per IP

# Concurrency caps (in-process FIFO semaphores; excess work queues).
# PRERENDER_CONCURRENCY=2            # concurrent headless-Chromium publish prerenders
# FIRECRAWL_CONCURRENCY=2            # concurrent Firecrawl /v1/scrape HTTP calls (generate-page reference scraping)
# GENERATE_OPENAI_CONCURRENCY=8      # concurrent OpenAI chat calls from /api/lp/generate-page (incl. retry + critique passes)
# BRAND_IMPORT_OPENAI_CONCURRENCY=3  # concurrent OpenAI calls from the brand importer (pre-existing)
