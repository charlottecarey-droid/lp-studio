auto-install-peers=false
strict-peer-dependencies=false
# pnpm 10 installs the exact version named in package.json "packageManager" before
# every command. On Replit that self-install (a native @pnpm/exe build under the
# Nix node) aborts and recurses forever, blocking installs and deploys. Use
# whichever pnpm the environment provides instead.
manage-package-manager-versions=false
