modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "img-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "tc-api"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "tc-lp"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e"

[[workflows.workflow]]
name = "img-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server && npx vitest run src/routes/lp/generate-page.images.test.ts --reporter=dot --pool=forks --no-file-parallelism"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "tc-api"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run typecheck"

[[workflows.workflow]]
name = "tc-lp"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/lp-studio run typecheck"

[[workflows.workflow]]
name = "e2e"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/lp-studio exec playwright test"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
RESEND_FROM_EMAIL = "LP Studio <notifications@ent.meetdandy.com>"
GOOGLE_REDIRECT_URI = "https://app.lpstudio.ai/api/auth/google/callback"
DEPLOYMENT_TARGET_CNAME = "image-to-video-ccarey.replit.app"
WILDCARD_TENANT_BASE_HOSTS = "lpstudio.ai,app.lpstudio.ai"

[userenv.production]
GITHUB_OAUTH_REDIRECT_URI = "https://app.lpstudio.ai/api/auth/github/callback"
